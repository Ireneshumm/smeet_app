{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "npm install --no-audit --no-fund",
  "buildCommand": "bash scripts/update_build_version.sh && npm run build",
  "outputDirectory": "build/web",
  "headers": [
    {
      "source": "/",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, must-revalidate, max-age=0"
        },
        {
          "key": "CDN-Cache-Control",
          "value": "no-cache, must-revalidate, max-age=0"
        },
        {
          "key": "Vercel-CDN-Cache-Control",
          "value": "no-cache, must-revalidate, max-age=0"
        }
      ]
    },
    {
      "source": "/index.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, must-revalidate, max-age=0"
        },
        {
          "key": "CDN-Cache-Control",
          "value": "no-cache, must-revalidate, max-age=0"
        },
        {
          "key": "Vercel-CDN-Cache-Control",
          "value": "no-cache, must-revalidate, max-age=0"
        }
      ]
    },
    {
      "source": "/(flutter_bootstrap\\.js|main\\.dart\\.js|flutter_service_worker\\.js)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, must-revalidate, max-age=0"
        },
        {
          "key": "CDN-Cache-Control",
          "value": "no-cache, must-revalidate, max-age=0"
        },
        {
          "key": "Vercel-CDN-Cache-Control",
          "value": "no-cache, must-revalidate, max-age=0"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/((?!privacy-policy\\.html|terms-of-service\\.html|google8a45994ba2e2a952\\.html).*)",
      "destination": "/index.html"
    }
  ]
}
