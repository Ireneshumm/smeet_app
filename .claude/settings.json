{
  "permissions": {
    "allow": [
      "Read",
      "Edit",
      "Write",
      "Glob",
      "Grep",
      "Bash(git *)",
      "Bash(flutter *)",
      "Bash(dart *)",
      "PowerShell(git *)",
      "PowerShell(flutter *)",
      "PowerShell(dart *)"
    ],
    "deny": [
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "PowerShell(git push --force*)",
      "PowerShell(git push -f*)",
      "Bash(flutter upgrade*)",
      "Bash(flutter pub upgrade*)",
      "PowerShell(flutter upgrade*)",
      "PowerShell(flutter pub upgrade*)",
      "Edit(.github/workflows/**)",
      "Write(.github/workflows/**)",
      "Edit(lib/core/config/**)",
      "Write(lib/core/config/**)",
      "Edit(ios/Runner/Info.plist)",
      "Write(ios/Runner/Info.plist)",
      "Edit(**/*.entitlements)",
      "Write(**/*.entitlements)",
      "Edit(**/GoogleService-Info.plist)",
      "Write(**/GoogleService-Info.plist)",
      "Edit(**/google-services.json)",
      "Write(**/google-services.json)",
      "Edit(.vscode/**)",
      "Write(.vscode/**)"
    ]
  }
}
